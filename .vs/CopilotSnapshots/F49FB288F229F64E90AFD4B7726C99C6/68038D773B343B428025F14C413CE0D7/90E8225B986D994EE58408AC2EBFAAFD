              </p>"
                : string.Empty;

            // Replace placeholders with actual values.
            htmlTemplate = htmlTemplate
                .Replace("##REPLY_TO_BLOCK##", replyToBlock)
                .Replace("##VIEW_IN_BROWSER_URL##", viewInBrowserUrl)
                .Replace("##TRACKING_ID##", trackingId);

            var htmlContent = htmlTemplate;

            if (!ValidateConfiguration(sender, recipients, replyToAddresses))
            {
                return;
            }

            // --------------------------------------------------------------------
            // Build the EmailClient (ACS Email SDK entry point)
            // --------------------------------------------------------------------
            var emailClient = new EmailClient(connectionString);

            // Build email content: HTML + plain-text fallback.
            var content = new EmailContent(subject)
            {
                Html = htmlContent,
                PlainText = $"Welcome! Your Azure Communication Services email sample was delivered. " +
                            $"Features: Flexible APIs, Tracking, Secure Delivery." +
                            (!string.IsNullOrWhiteSpace(replyToDisplay)
                                ? $" Replies will be directed to: {replyToDisplay}."
                                : string.Empty) +
                            $" Tracking Id: {trackingId}."
            };

            var emailMessage = new EmailMessage(sender, recipients, content);

            // Set Reply-To list using the same addresses used in the body.
            foreach (var addr in replyToAddresses)
            {
                emailMessage.ReplyTo.Add(new EmailAddress(addr));
            }

            // Custom headers for tracking/correlation.
            emailMessage.Headers.Add("X-Tracking-ID", trackingId);
            emailMessage.Headers.Add("X-Template-Version", "v1.1");

            // Correlation / diagnostics headers.
            emailMessage.Headers.Add("X-Environment", environmentTag);
            emailMessage.Headers.Add("X-Campaign", campaignName);
            emailMessage.Headers.Add("X-Mailer", mailerId);

            // Importance headers (x-priority / x-msmail-priority).
            switch (importance.ToLowerInvariant())
            {
                case "high":
                    emailMessage.Headers.Add("X-Priority", "1");
                    emailMessage.Headers.Add("X-MSMail-Priority", "High");
                    break;

                case "low":
                    emailMessage.Headers.Add("X-Priority", "5");
                    emailMessage.Headers.Add("X-MSMail-Priority", "Low");
                    break;

                default:
                    emailMessage.Headers.Add("X-Priority", "3");
                    emailMessage.Headers.Add("X-MSMail-Priority", "Normal");
                    break;
            }

            // Optional read-receipt request.
            if (requestReadReceipt && replyToAddresses.Length > 0)
            {
                emailMessage.Headers.Add("Disposition-Notification-To", replyToAddresses[0]);
            }

            // Optional List-Unsubscribe / List-Unsubscribe-Post headers.
            string? listUnsubscribeHeader = null;

            if (!string.IsNullOrWhiteSpace(listUnsubscribeUrl) &&
                !string.IsNullOrWhiteSpace(listUnsubscribeMailto))
            {
                listUnsubscribeHeader = $"<{listUnsubscribeUrl}>, <{listUnsubscribeMailto}>";
            }
            else if (!string.IsNullOrWhiteSpace(listUnsubscribeUrl))
            {
                listUnsubscribeHeader = $"<{listUnsubscribeUrl}>";
            }
            else if (!string.IsNullOrWhiteSpace(listUnsubscribeMailto))
            {
                listUnsubscribeHeader = $"<{listUnsubscribeMailto}>";
            }

            if (!string.IsNullOrWhiteSpace(listUnsubscribeHeader))
            {
                emailMessage.Headers.Add("List-Unsubscribe", listUnsubscribeHeader);
                emailMessage.Headers.Add("List-Unsubscribe-Post", "List-Unsubscribe=One-Click");
            }

            // Reserved ACS headers (only added when explicitly enabled).
            if (ignoreDuplicateContentId)
            {
                emailMessage.Headers.Add("x-ms-acsemail-ignore-duplicate-content-id", "true");
            }

            if (suppressInvalidAttachment)
            {
                emailMessage.Headers.Add("x-ms-acsemail-suppress-invalid-attachment", "true");
            }

            if (validateMessageId && !string.IsNullOrWhiteSpace(explicitMessageId))
            {
                emailMessage.Headers.Add("Message-Id", explicitMessageId);
                emailMessage.Headers.Add("x-ms-acsemail-validate-message-id", "true");
            }

            // --------------------------------------------------------------------
            // Pre-send logging – shows exactly what we are about to send.
            // Include CC/BCC only when present.
            // --------------------------------------------------------------------
            var toDisplay = string.Join(
                ", ",
                emailMessage.Recipients.To?.Select(r => r.Address) ?? Enumerable.Empty<string>());

            var ccDisplay = string.Join(
                ", ",
                emailMessage.Recipients.CC?.Select(r => r.Address) ?? Enumerable.Empty<string>());

            var bccDisplay = string.Join(
                ", ",
                emailMessage.Recipients.BCC?.Select(r => r.Address) ?? Enumerable.Empty<string>());

            var ccLine = string.IsNullOrWhiteSpace(ccDisplay) ? string.Empty : $"\n                Cc          : {ccDisplay}";
            var bccLine = string.IsNullOrWhiteSpace(bccDisplay) ? string.Empty : $"\n                Bcc         : {bccDisplay}";

            Log($@"[INFO] Sending email
                From        : {sender}
                To          : {toDisplay}{ccLine}{bccLine}
                Reply-To    : {string.Join(", ", emailMessage.ReplyTo.Select(r => r.Address))}
                Subject     : {subject}
                Tracking Id : {emailMessage.Headers["X-Tracking-ID"]}");

            Log("[INFO] Custom headers: " +
                string.Join(", ", emailMessage.Headers.Select(kvp => $"{kvp.Key}={kvp.Value}")));

            // --------------------------------------------------------------------
            // Send email + manual, bounded polling (instead of WaitUntil.Completed)
            // --------------------------------------------------------------------
            if (options.DryRun)
            {
                Log("[DRY-RUN] --dry-run specified. Skipping send.");
                return;
            }

            var waitMode = WaitUntil.Started; // Don't block indefinitely inside SDK.
            Log($"[SEND] Initiating send ({waitMode})...");

            try
            {
                EmailSendOperation operation = await emailClient.SendAsync(waitMode, emailMessage);

                Log($"[SEND] Operation started. Id={operation.Id}");

                var pollInterval = options.PollInterval;
                var maxPollTime = options.MaxPollTime;
                var pollCount = 0;
                var pollStartUtc = DateTime.UtcNow;

                Log($"[POLL] Polling every {pollInterval.TotalMilliseconds} ms, up to {maxPollTime.TotalSeconds} s...");

                while (true)
                {
                    pollCount++;

                    await operation.UpdateStatusAsync();

                    bool hasCompleted = operation.HasCompleted;
                    bool hasValue = operation.HasValue;
                    string serviceStatus = hasValue ? operation.Value.Status.ToString() : "NoValueYet";

                    if (!hasCompleted)
                    {
                        Log($"[POLL] #{pollCount} - Running");
                    }
                    else
                    {
                        var totalSendSeconds = (DateTime.UtcNow - pollStartUtc).TotalSeconds;
                        Log($"[POLL] #{pollCount} - Completed ({serviceStatus}) (took {totalSendSeconds:F3}s)");
                        Log("[DONE] Operation reported completion.");
                        break;
                    }

                    var elapsedPollTime = DateTime.UtcNow - pollStartUtc;
                    if (elapsedPollTime > maxPollTime)
                    {
                        Log($"[WARN] Polling timed out after {elapsedPollTime.TotalSeconds:F1}s. Operation may still complete server-side.");
                        break;
                    }

                    await Task.Delay(pollInterval);
                }

                if (operation.HasValue)
                {
                    Log($"[STATUS] Final email operation status (as observed) = {operation.Value.Status}");
                }
                else
                {
                    Log("[WARN] Operation finished polling window without an operation value.");
                }

                Log($"[INFO] Operation Id = {operation.Id}");
            }
            catch (RequestFailedException ex)
            {
                Log($"[ERROR] Send failed. Code={ex.ErrorCode} Message={ex.Message}");
            }
            catch (Exception ex)
            {
                Log($"[ERROR] Unexpected exception: {ex.GetType().Name} - {ex.Message}");
            }
        }

        /// <summary>
        /// Writes a timestamped log message with elapsed seconds since the start of the run.
        /// </summary>
        private static void Log(string message)
        {
            var now = DateTime.UtcNow;
            var elapsed = now - _startUtc;
            Console.WriteLine($"[{now:yyyy-MM-dd HH:mm:ss.fff} UTC | +{elapsed.TotalSeconds,8:F3}s] {message}");
        }

        /// <summary>
        /// Determines whether the app should behave in interactive mode.
        /// </summary>
        private static bool IsInteractive(string[] args)
        {
            static void ShowHelp()
            {
                Console.WriteLine("Azure Communication Services Email Sample");
                Console.WriteLine();
                Console.WriteLine("Usage:");
                Console.WriteLine("  EmailQuickstart.exe [options]");
                Console.WriteLine();
                Console.WriteLine("Options:");
                Console.WriteLine("  --interactive, -i            Force interactive mode (prompts for Ctrl+R / Enter).");
                Console.WriteLine("  --noninteractive, -ni, -n    Run once and exit; suitable for Task Scheduler, etc.");
                Console.WriteLine("  --non-interactive            Alias of --noninteractive.");
                Console.WriteLine("  --sender <email>             Sender address (env: ACS_SENDER). Required to send.");
                Console.WriteLine("  --to <emails>                Comma/semicolon separated To list (env: ACS_TO). Required to send.");
                Console.WriteLine("  --cc <emails>                Comma/semicolon separated Cc list (env: ACS_CC).");
                Console.WriteLine("  --bcc <emails>               Comma/semicolon separated Bcc list (env: ACS_BCC).");
                Console.WriteLine("  --reply-to <emails>          Comma/semicolon separated Reply-To list (env: ACS_REPLY_TO).");
                Console.WriteLine("  --subject <text>             Email subject (env: ACS_SUBJECT)." );
                Console.WriteLine("  --view-url <url>             View-in-browser URL (env: ACS_VIEW_IN_BROWSER_URL)." );
                Console.WriteLine("  --poll-interval-ms <int>     Poll interval in milliseconds (env: ACS_POLL_INTERVAL_MS, default 500)." );
                Console.WriteLine("  --max-poll-seconds <int>     Poll timeout in seconds (env: ACS_MAX_POLL_SECONDS, default 60)." );
                Console.WriteLine("  --dry-run                    Build and log the message without sending.");
                Console.WriteLine("  --help, -h, /?               Show this help and exit.");
            }

            var normalizedArgs = args
                .Where(a => !string.IsNullOrWhiteSpace(a))
                .Select(a => a.Trim())
                .ToArray();

            if (normalizedArgs.Any(a =>
                    string.Equals(a, "--help", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(a, "-h", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(a, "/?", StringComparison.OrdinalIgnoreCase)))
            {
                ShowHelp();
                Environment.Exit(0);
            }

            if (normalizedArgs.Any(a =>
                    string.Equals(a, "--noninteractive", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(a, "--non-interactive", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(a, "-ni", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(a, "-n", StringComparison.OrdinalIgnoreCase)))
            {
                return false;
            }

            if (normalizedArgs.Any(a =>
                    string.Equals(a, "--interactive", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(a, "-i", StringComparison.OrdinalIgnoreCase)))
            {
                return true;
            }

            try
            {
                return Environment.UserInteractive && !Console.IsInputRedirected;
            }
            catch
            {
                return false;
            }
        }

        private sealed record Options(
            string Sender,
            string[] To,
            string[] Cc,
            string[] Bcc,
            string[] ReplyTo,
            string Subject,
            string ViewInBrowserUrl,
            TimeSpan PollInterval,
            TimeSpan MaxPollTime,
            bool DryRun);

        private static Options ParseOptions(string[] args)
        {
            var normalizedArgs = args
                .Where(a => !string.IsNullOrWhiteSpace(a))
                .Select(a => a.Trim())
                .ToArray();

            string? GetEnv(string name) => Environment.GetEnvironmentVariable(name);

            string? GetArgValue(string longName)
            {
                for (int i = 0; i < normalizedArgs.Length; i++)
                {
                    var a = normalizedArgs[i];
                    if (!string.Equals(a, longName, StringComparison.OrdinalIgnoreCase))
                    {
                        continue;
                    }

                    if (i + 1 >= normalizedArgs.Length)
                    {
                        return null;
                    }

                    return normalizedArgs[i + 1];
                }

                return null;
            }

            bool HasFlag(string longName) => normalizedArgs.Any(a => string.Equals(a, longName, StringComparison.OrdinalIgnoreCase));

            static string[] SplitEmails(string? raw)
            {
                if (string.IsNullOrWhiteSpace(raw))
                {
                    return Array.Empty<string>();
                }

                return raw
                    .Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Where(s => !string.IsNullOrWhiteSpace(s))
                    .ToArray();
            }

            static int? TryParseInt(string? raw)
                => int.TryParse(raw, out var i) ? i : null;

            var sender = GetArgValue("--sender") ?? GetEnv("ACS_SENDER") ?? string.Empty;
            var to = SplitEmails(GetArgValue("--to") ?? GetEnv("ACS_TO"));
            var cc = SplitEmails(GetArgValue("--cc") ?? GetEnv("ACS_CC"));
            var bcc = SplitEmails(GetArgValue("--bcc") ?? GetEnv("ACS_BCC"));
            var replyTo = SplitEmails(GetArgValue("--reply-to") ?? GetEnv("ACS_REPLY_TO"));

            var subject = GetArgValue("--subject") ?? GetEnv("ACS_SUBJECT") ?? "Welcome to Azure Communication Service Email APIs";
            var viewUrl = GetArgValue("--view-url") ?? GetEnv("ACS_VIEW_IN_BROWSER_URL") ?? "https://example.com/view-in-browser";

            var pollIntervalMs = TryParseInt(GetArgValue("--poll-interval-ms") ?? GetEnv("ACS_POLL_INTERVAL_MS")) ?? 500;
            var maxPollSeconds = TryParseInt(GetArgValue("--max-poll-seconds") ?? GetEnv("ACS_MAX_POLL_SECONDS")) ?? 60;

            var dryRun = HasFlag("--dry-run") || string.Equals(GetEnv("ACS_DRY_RUN"), "true", StringComparison.OrdinalIgnoreCase);

            return new Options(
                Sender: sender,
                To: to,
                Cc: cc,
                Bcc: bcc,
                ReplyTo: replyTo,
                Subject: subject,
                ViewInBrowserUrl: viewUrl,
                PollInterval: TimeSpan.FromMilliseconds(Math.Max(1, pollIntervalMs)),
                MaxPollTime: TimeSpan.FromSeconds(Math.Max(1, maxPollSeconds)),
                DryRun: dryRun);
        }

        private static EmailRecipients BuildRecipients(Options options)
        {
            EmailAddress[] to = options.To.Select(a => new EmailAddress(a)).ToArray();
            EmailAddress[] cc = options.Cc.Select(a => new EmailAddress(a)).ToArray();
            EmailAddress[] bcc = options.Bcc.Select(a => new EmailAddress(a)).ToArray();

            return new EmailRecipients(
                to: to,
                cc: cc.Length > 0 ? cc : null,
                bcc: bcc.Length > 0 ? bcc : null);
        }

        private static bool ValidateConfiguration(string sender, EmailRecipients recipients, string[] replyTo)
        {
            if (string.IsNullOrWhiteSpace(sender))
            {
                Log("[ERROR] Sender is required. Specify --sender or set ACS_SENDER.");
                return false;
            }

            var toCount = recipients.To?.Count ?? 0;
            if (toCount == 0)
            {
                Log("[ERROR] At least one To recipient is required. Specify --to or set ACS_TO.");
                return false;
            }

            if (replyTo.Length == 0)
            {
                Log("[INFO] No Reply-To addresses specified (optional). Use --reply-to or ACS_REPLY_TO to set.");
            }

            return true;
        }
    }
