/*
 * -----------------------------------------------------------------------------
 *  File Name   : Program.cs
 *  Description : Sample console application that sends a branded welcome email
 *                using Azure Communication Services Email. Supports both
 *                interactive (Ctrl+R to resend, Enter to exit) and
 *                non-interactive (Task Scheduler / service) execution modes.
 *
 *  Author      : Blake Drumm (blakedrumm@microsoft.com)
 *  Created     : November 18th, 2025
 *  Modified    : November 19th, 2025
 *  Version     : 1.0.0
 *
 *  Notes       : 
 *    - Expects the ACS connection string in the
 *      COMMUNICATION_SERVICES_CONNECTION_STRING environment variable.
 *    - Uses HTML + plain text content and logs status/polling information
 *      with UTC timestamps and elapsed time.
 * -----------------------------------------------------------------------------
 */

