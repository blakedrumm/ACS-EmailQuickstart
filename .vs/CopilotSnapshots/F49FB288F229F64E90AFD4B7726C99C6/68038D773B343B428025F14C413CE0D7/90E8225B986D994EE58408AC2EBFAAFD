        // Used to compute relative timestamps for the Log() method.
        private static DateTime _startUtc;

        static async Task Main(string[] args)
        {
            var options = ParseOptions(args);

            // Determine whether we're running in an interactive console.
            bool interactive = IsInteractive(args);

            if (interactive)
            {
                // Treat Ctrl+C as an input key, not as a process-kill signal.
                // This allows us to use Ctrl+R for restart logic without killing the app.
                Console.TreatControlCAsInput = true;
                Log("[MODE] Interactive console detected. Ctrl+R = resend, Enter = exit.");
            }
            else
            {
                Log("[MODE] Non-interactive detected (Task Scheduler / service / redirected I/O).");
            }

            // -----------------------------------------------------------------
            // Non-interactive: run once and exit (no waiting for key input).
            // -----------------------------------------------------------------
            if (!interactive)
            {
                _startUtc = DateTime.UtcNow;
                await RunOnceAsync(options);
                Log("[EXIT] Non-interactive run finished. Exiting application.");
                return;
            }

            // -----------------------------------------------------------------
            // Interactive mode: allow repeated runs with Ctrl+R.
            // -----------------------------------------------------------------
            while (true)
            {
                // Mark the start time for this run so Log() can show elapsed seconds.
                _startUtc = DateTime.UtcNow;

                // Run the email send workflow once.
                await RunOnceAsync(options);

                // After one full run, wait for user input to either exit or restart.
                Log("[END] Press Enter to exit, or press Ctrl+R to resend.");
                while (true)
                {
                    // Read a key without echoing to the console.
                    var key = Console.ReadKey(intercept: true);

                    bool ctrlR = key.Key == ConsoleKey.R && key.Modifiers.HasFlag(ConsoleModifiers.Control);
                    bool enter = key.Key == ConsoleKey.Enter && key.Modifiers == 0;

                    if (ctrlR)
                    {
                        Log("[RESTART] Ctrl+R detected. Restarting send workflow...");
                        // Break inner loop -> outer while(true) repeats RunOnceAsync().
                        break;
                    }

                    if (enter)
                    {
                        Log("[EXIT] Enter pressed. Exiting application.");
                        return; // End the process.
                    }

                    // Ignore all other keys.
                }
            }
        }

